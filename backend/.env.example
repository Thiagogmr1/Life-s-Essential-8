# ==============================================================================
# NATSA API — Exemplo de Variáveis de Ambiente (.env)
# Copie este arquivo para `backend/.env` e preencha com seus dados reais:
#   cp .env.example .env
# NUNCA comite o arquivo `.env` preenchido com dados reais no Git!
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natsa_db
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui

# Chave Secreta para Assinatura de Tokens JWT
# Gere uma chave forte de 32 bytes no terminal com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cole_aqui_sua_chave_secreta_aleatoria_de_32_bytes

# Ambiente de Execução
# Use "dev" para ambiente de desenvolvimento local
# Use "production" para deploy em produção (ativa HTTPS e SameSite=None nos cookies)
ENV=dev

# URLs permitidas para requisições CORS (usado apenas quando ENV=production)
# Separe múltiplos domínios por vírgula:
# FRONTEND_URL=https://natsa.seu-dominio.com.br,https://outro-dominio.com.br
FRONTEND_URL=
